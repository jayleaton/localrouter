diff --git a/zig/src/native/drama_prefix.zig b/zig/src/native/drama_prefix.zig
new file mode 100644
index 00000000..5cea0c49
--- /dev/null
+++ b/zig/src/native/drama_prefix.zig
@@ -0,0 +1,157 @@
+//! Drama 3's prompt prefix cache: the backbone and tower state after a prompt's reference rows (its system message),
+//! so a later prompt whose first rows are the same resumes its prompt pass after them. Entries are compared row by
+//! row in full; DRAMA_PREFIX_CACHE sets how many are kept (0: none), the least recently used dropped first.
+const std = @import("std");
+const cuda = @import("cuda");
+const api = @import("engine_api");
+const drama = @import("drama");
+const Allocator = std.mem.Allocator;
+
+const Frame = drama.tower.Frame;
+const Backbone = drama.backbone.Model;
+const Tower = drama.tower.Model;
+
+/// Entries kept without DRAMA_PREFIX_CACHE.
+pub const default_capacity = 2;
+
+/// u32 a row's frame takes in a key.
+const width = 11;
+
+comptime {
+    std.debug.assert(@sizeOf(Frame) == width * 4);
+}
+
+/// Prompt row `i`'s frame: its token, then its codes when the prompt carries them.
+pub fn promptFrame(r: *const api.SpeechRequest, i: usize) Frame {
+    var frame: Frame = @splat(0);
+    frame[0] = r.prompt[i];
+    if (r.codes.len > 0) frame[1..].* = r.codes[i];
+    return frame;
+}
+
+/// The rows a request's prompt pass may resume after: its prefix_rows, or 0 unless they leave a row to run.
+pub fn prefixRows(r: *const api.SpeechRequest) usize {
+    const rows: usize = r.prefix_rows;
+    return if (rows < r.prompt.len) rows else 0;
+}
+
+const Entry = struct {
+    /// Prompt rows [0, rows] as frames: row `rows` too, the label the tower's last prefix chunk was taught with.
+    key: []u32,
+    rows: usize,
+    /// Backbone.snapshot's bytes, then Tower.snapshot's.
+    buffer: cuda.DeviceBuffer,
+    saved: Backbone.Saved,
+    used: u64,
+
+    fn matches(e: *const Entry, r: *const api.SpeechRequest, rows: usize) bool {
+        if (e.rows != rows) return false;
+        for (0..rows + 1) |i| {
+            const frame = promptFrame(r, i);
+            if (!std.mem.eql(u32, &frame, e.key[i * width ..][0..width])) return false;
+        }
+        return true;
+    }
+};
+
+pub const Cache = struct {
+    gpa: Allocator,
+    capacity: usize,
+    entries: std.ArrayList(Entry) = .empty,
+    clock: u64 = 0,
+    warned: bool = false,
+
+    /// DRAMA_PREFIX_CACHE entries (a whole number), else default_capacity.
+    pub fn init(gpa: Allocator) !Cache {
+        const text = std.mem.span(std.c.getenv("DRAMA_PREFIX_CACHE") orelse return .{ .gpa = gpa, .capacity = default_capacity });
+        const capacity = std.fmt.parseInt(usize, text, 10) catch {
+            std.log.err("drama: DRAMA_PREFIX_CACHE={s}: a whole number of entries", .{text});
+            return error.BadDramaPrefixCache;
+        };
+        return .{ .gpa = gpa, .capacity = capacity };
+    }
+
+    /// Frees every entry's device and host memory (the context current, its stream idle).
+    pub fn deinit(c: *Cache) void {
+        for (c.entries.items) |*e| free(c.gpa, e);
+        c.entries.deinit(c.gpa);
+        c.* = undefined;
+    }
+
+    fn free(gpa: Allocator, e: *Entry) void {
+        e.buffer.free();
+        gpa.free(e.key);
+    }
+
+    /// The entry holding the request's rows [0, rows], marked used; null when none does.
+    pub fn find(c: *Cache, r: *const api.SpeechRequest, rows: usize) ?usize {
+        for (c.entries.items, 0..) |*e, i| if (e.matches(r, rows)) {
+            c.clock += 1;
+            e.used = c.clock;
+            return i;
+        };
+        return null;
+    }
+
+    /// Entry `i` into both models, each just reset; on failure both need a reset again.
+    pub fn restore(c: *const Cache, i: usize, s: cuda.Stream, b: *Backbone, t: *Tower) !void {
+        const e = &c.entries.items[i];
+        try b.restore(s, e.buffer.ptr, e.saved);
+        try t.restore(s, e.buffer.ptr + Backbone.snapshotBytes(e.rows), e.rows);
+        std.log.info("drama: prefix cache: resumed after {d} prompt rows ({d} MiB)", .{ e.rows, e.buffer.len >> 20 });
+    }
+
+    pub fn drop(c: *Cache, i: usize) void {
+        free(c.gpa, &c.entries.items[i]);
+        _ = c.entries.swapRemove(i);
+    }
+
+    /// Both models' state after the request's first `rows` rows (the pass ending there synchronized) as a new entry,
+    /// the least recently used dropped first when full. Never fails the request: a failure leaves no entry.
+    pub fn store(c: *Cache, s: cuda.Stream, d: *const cuda.Driver, b: *const Backbone, t: *const Tower, r: *const api.SpeechRequest, rows: usize) void {
+        if (c.capacity == 0) return;
+        if (c.entries.items.len >= c.capacity) c.drop(c.oldest());
+        const bytes = Backbone.snapshotBytes(rows) + Tower.snapshotBytes(rows);
+        var buffer = cuda.DeviceBuffer.alloc(d, bytes) catch |e| {
+            if (!c.warned) std.log.warn("drama: prefix cache: no room for {d} MiB ({s}); prompts without an entry are prefilled whole", .{ bytes >> 20, @errorName(e) });
+            c.warned = true;
+            return;
+        };
+        c.fill(s, buffer, b, t, r, rows) catch |e| {
+            buffer.free();
+            std.log.warn("drama: prefix cache: no entry for {d} prompt rows: {s}", .{ rows, @errorName(e) });
+            return;
+        };
+        std.log.info("drama: prefix cache: kept {d} prompt rows ({d} MiB), {d} of {d} entries", .{ rows, bytes >> 20, c.entries.items.len, c.capacity });
+    }
+
+    fn fill(c: *Cache, s: cuda.Stream, buffer: cuda.DeviceBuffer, b: *const Backbone, t: *const Tower, r: *const api.SpeechRequest, rows: usize) !void {
+        try c.entries.ensureUnusedCapacity(c.gpa, 1);
+        const key = try c.gpa.alloc(u32, (rows + 1) * width);
+        errdefer c.gpa.free(key);
+        for (0..rows + 1) |i| key[i * width ..][0..width].* = promptFrame(r, i);
+        const split = Backbone.snapshotBytes(rows);
+        const saved = try b.snapshot(s, buffer);
+        const tower = try t.snapshot(s, .{ .d = buffer.d, .ptr = buffer.ptr + split, .len = buffer.len - split, .borrowed = true });
+        if (saved.pos != rows or tower != rows) return error.DramaPrefixRows;
+        c.clock += 1;
+        c.entries.appendAssumeCapacity(.{ .key = key, .rows = rows, .buffer = buffer, .saved = saved, .used = c.clock });
+    }
+
+    fn oldest(c: *const Cache) usize {
+        var at: usize = 0;
+        for (c.entries.items, 0..) |e, i| if (e.used < c.entries.items[at].used) {
+            at = i;
+        };
+        return at;
+    }
+};
+
+test "a request resumes only after rows that leave one to run" {
+    var result: api.SpeechResult = .{};
+    var r: api.SpeechRequest = .{ .prompt = &.{ 1, 2, 3 }, .pcm = &.{}, .result = &result, .seed = 0, .prefix_rows = 2 };
+    try std.testing.expectEqual(@as(usize, 2), prefixRows(&r));
+    r.prefix_rows = 3;
+    try std.testing.expectEqual(@as(usize, 0), prefixRows(&r));
+    try std.testing.expectEqual(@as(u32, 2), promptFrame(&r, 1)[0]);
+}
