+    /// A snapshot's host half: the position and every DeltaNet layer's chunk metadata (its addresses are this Model's).
+    pub const Saved = struct { pos: usize, gdn_states: [config.linear_layers]gdn.State };
+
+    /// Device bytes of a snapshot after `rows` rows: the whole state buffer, then each attention layer's k and v rows.
+    pub fn snapshotBytes(rows: usize) usize {
+        return config.linear_layers * (conv_state_bytes + gdn_state_bytes) + 2 * config.full_layers * kvBytes(rows);
+    }
+
+    /// The request's state after its `pos` rows into `dst` (snapshotBytes(pos) bytes) on `stream`, waited for.
+    pub fn snapshot(self: *const Model, stream: cuda.Stream, dst: cuda.DeviceBuffer) !Saved {
+        if (self.poisoned) return error.DramaStateNeedsReset;
+        const bytes = kvBytes(self.pos);
+        try dst.copyFrom(0, self.state_buf.ptr, self.state_buf.len, stream.handle);
+        for (0..2 * config.full_layers) |c| try dst.copyFrom(self.state_buf.len + c * bytes, self.kv_buf.ptr + c * kvBytes(self.options.context), bytes, stream.handle);
+        try stream.synchronize();
+        return .{ .pos = self.pos, .gdn_states = self.gdn_states };
+    }
+
+    /// Right after `reset`: the state a `snapshot` copied to `src`, so the next run continues at saved.pos. KV rows
+    /// past it are rewritten before they are read, as after reset. A failure leaves the model needing a reset.
+    pub fn restore(self: *Model, stream: cuda.Stream, src: u64, saved: Saved) !void {
+        if (self.poisoned) return error.DramaStateNeedsReset;
+        if (self.pos != 0) return error.DramaRestoreNeedsReset;
+        if (saved.pos > self.options.context) return error.DramaContextOverflow;
+        self.poisoned = true;
+        const bytes = kvBytes(saved.pos);
+        try self.state_buf.copyFrom(0, src, self.state_buf.len, stream.handle);
+        for (0..2 * config.full_layers) |c| try self.kv_buf.copyFrom(c * kvBytes(self.options.context), src + self.state_buf.len + c * bytes, bytes, stream.handle);
+        try stream.synchronize();
+        self.gdn_states = saved.gdn_states;
+        self.pos = saved.pos;
+        self.poisoned = false;
+    }
+
     fn kvBytes(context: usize) usize {
         return context * config.kv_heads * config.head_dim * 2;
     }
