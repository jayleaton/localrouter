+
+    /// After a prefill, no row staged: the cache rows before `position` into `dst` on `stream`, waited for; their
+    /// count. Nothing else a prefill writes outlives it (result and seed are reset's, from the request).
+    pub fn snapshot(self: *const Model, stream: cuda.Stream, dst: Buffer) !usize {
+        const p = self.impl;
+        if (p.input_rows != 0 or p.step != 0) return error.BadTowerRows;
+        const cache_bytes = p.options.context * kv_width * 2;
+        const bytes = p.position * kv_width * 2;
+        for (0..layer_count * 2) |c| try dst.copyFrom(c * bytes, p.cache.ptr + c * cache_bytes, bytes, stream.handle);
+        try stream.synchronize();
+        return p.position;
+    }
+
+    /// Right after `reset`: `rows` cache rows a `snapshot` copied to `src`; the next prefill continues after them.
+    pub fn restore(self: *Model, stream: cuda.Stream, src: u64, rows: usize) !void {
+        const p = self.impl;
+        if (p.position != 0 or p.step != 0 or rows > p.options.context) return error.BadTowerRows;
+        const cache_bytes = p.options.context * kv_width * 2;
+        const bytes = rows * kv_width * 2;
+        for (0..layer_count * 2) |c| try p.cache.copyFrom(c * cache_bytes, src + c * bytes, bytes, stream.handle);
+        try stream.synchronize();
+        p.position = rows;
+        p.input_rows = 0;
+    }
