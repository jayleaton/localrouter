{
  "$schema": "https://opencode.ai/config.json",
  "model": "spark/qwen3.8-27b",
  "small_model": "spark/qwen3.8-27b",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LocalRouter (Spark)",
      "options": {
        "baseURL": "{env:LOCALROUTER_URL}/v1",
        "apiKey": "{env:LOCALROUTER_TOKEN}",
        "timeout": 600000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B on the Spark",
          "tool_call": true,
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "spark": {
      "type": "remote",
      "url": "{env:LOCALROUTER_URL}/mcp",
      "headers": { "Authorization": "Bearer {env:LOCALROUTER_TOKEN}" },
      "oauth": false,
      "timeout": 30000,
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "deny",
    "webfetch": "deny",
    "external_directory": "deny"
  }
}
