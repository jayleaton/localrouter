{
 "machine": "dgx-01",
 "reserve_bytes": 3221225472,
 "local_files": ["@DEPLOY@/inbox"],
 "defaults": {"chat_completion": "qwen3.8-27b", "text_to_speech": "fishaudio/drama-3",
              "speech_to_text": "whisper-large-v3-turbo", "text_to_image": "qwen-image-2.1-turbo",
              "text_to_video": "minimax-h3", "typed_decision": "knowline-4b"},
 "voice": {
  "chat_extra": {"chat_template_kwargs": {"enable_thinking": false}, "reasoning_effort": "none", "top_p": 0.8},
  "temperature": 0.7,
  "speech_models": ["fishaudio/drama-3"],
  "prime_chat": true, "greedy_transcripts": true,
  "partial_interval_ms": 0, "tool_wait_s": 900, "manage_models": true, "shadow_decisions": true
 },
 "tools": [
  {"id": "qwen3.8-27b", "kind": "chat", "name": "Qwen3.8 27B (TensorFold 1.1.1, MLX 4-bit + DFlash2 drafter)",
   "engine": "openai_server", "weights": "@CHAT_ROOT@/hf", "qualification": "@CHAT_MARKER@",
   "resident_bytes": 23756537856, "working_bytes": 0, "keep_loaded": true, "priority": 100, "idle_ttl_s": 600,
   "license": {"name": "Apache-2.0", "url": "https://huggingface.co/TensorFold/Qwen3.8-27B-MLX-4bit",
               "use": "the checkpoint (base Qwen/Qwen3.8-27B) and the z-lab DFlash2 drafter", "commercial": true},
   "load_timeout_s": 900, "generate_timeout_s": 600,
   "options": {"server": ["@CHAT_ROOT@/tensorfold-1.1.1/bin/tensorfold-native", "serve", "TensorFold/Qwen3.8-27B-MLX-4bit",
                          "--drafter", "z-lab/Qwen3.8-27B-DFlash2", "--host", "127.0.0.1", "--port", "{port}",
                          "--name", "{id}", "--context", "32768", "--prompt-cache-gib", "3", "--parallel", "1",
                          "--no-update-check"],
               "env": {"HF_HUB_CACHE": "@CHAT_ROOT@/hf", "HF_HUB_OFFLINE": "1", "TENSORFOLD_NO_UPDATE_CHECK": "1",
                       "TF_DRAIN_S": "5"},
               "health": "/health"}},
  {"id": "fishaudio/drama-3", "kind": "speech", "name": "Fish Audio Drama 3 (TensorFold native, 44.1 kHz). Built with Fish Audio",
   "cmd": ["/usr/bin/python3", "-I", "@SRC@/tools/speech/drama3/drama3_worker.py"], "weights": "@DRAMA_ROOT@",
   "qualification": "@DRAMA_MARKER@", "resident_bytes": @DRAMA_RESIDENT@, "working_bytes": 0, "keep_loaded": true,
   "priority": 95, "lane": "realtime", "idle_ttl_s": 600, "load_timeout_s": 1200, "generate_timeout_s": 900,
   "license": {"name": "Fish Audio Community License v1.0",
               "url": "https://huggingface.co/fishaudio/drama-3/blob/e0a9218aa48888270f06ef1ed9ea67622c0e17d2/LICENSE",
               "use": "research and non-commercial use; commercial use only under USD 500,000 annual revenue; no Hosted Service (third parties generating speech, e.g. through an API) without a separate licence from Fish Audio",
               "commercial": true, "notice": "Built with Fish Audio"},
   "options": {"variant": "@DRAMA_VARIANT@", "voices": ["Mae", "Arlo", "Ezra", "Nora", "Theo", "Wren"], "default_voice": "Mae",
               "voices_dir": "@DRAMA_ROOT@/voices", "min_speed": 1, "max_speed": 1,
               "max_input_chars": 4096, "stream": true, "references": true, "instructions": "[{s}] ", "port": @DRAMA_PORT@,
               "max_frames": 1024, "long_form": false, "verify": "size"}},
  {"id": "whisper-large-v3-turbo", "kind": "transcription", "name": "Whisper large-v3-turbo",
   "cmd": ["@J@/venvs/whisper/bin/python", "@SRC@/tools/speech/whisper/worker.py"], "weights": "@WHISPER@",
   "resident_bytes": 4026531840, "working_bytes": 536870912, "keep_loaded": true, "priority": 90, "idle_ttl_s": 3600,
   "license": {"name": "MIT", "url": "https://huggingface.co/openai/whisper-large-v3-turbo", "commercial": true},
   "options": {"device": "cuda", "dtype": "float16", "attn": "sdpa", "threads": 4, "vad": "silero",
               "vad_model": "@J@/models/vad/silero_vad.jit"}},
  {"id": "qwen-image-2.1-turbo", "kind": "image", "name": "Qwen-Image 2.1 Turbo (FP8, 8 steps)",
   "engine": "qwen_image_turbo", "weights": "@J@/lr/weights/qwen-image-2.1", "idle_ttl_s": 60, "priority": 10, "keep_loaded": true,
   "options": {"precision": "fp8s", "max_side": 1360, "max_pixels": 1048576, "edit_refs": 2, "resident_mb": 42550}},
  {"id": "minimax-h3", "kind": "video", "name": "MiniMax H3 (NVFP4, Turbo 8 steps, with audio)",
   "engine": "minimax_h3", "weights": "@J@/lr/weights/minimax-h3", "idle_ttl_s": 30, "priority": 0,
   "options": {"max_width": 1280, "max_height": 704, "max_seconds": 8, "default_size": "768x448", "resident_mb": 53567}},
  {"id": "knowline-4b", "kind": "decision", "name": "KnowLine-4B Gen5.5 (typed decisions, System One shape; bf16, transformers)",
   "engine": "openai_server", "weights": "@J@/models/decide/knowline-4b-gen5.5",
   "resident_bytes": 13290209280, "working_bytes": 0, "keep_loaded": true, "spare_room_only": true, "priority": 15, "idle_ttl_s": 600,
   "load_timeout_s": 300, "generate_timeout_s": 60,
   "license": {"name": "Apache-2.0", "url": "https://huggingface.co/PelaAI/KnowLine-4B-Gen5.5", "commercial": true},
   "options": {"server": ["@J@/venvs/decide/bin/python", "-I", "@SRC@/tools/decide/knowline/serve.py", "{weights}",
                          "--port", "{port}", "--served-model-name", "{id}"],
               "env": {"HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1"}, "health": "/health"}}
 ]
}
