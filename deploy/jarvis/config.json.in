{
 "machine": "dgx-01",
 "reserve_bytes": 6442450944,
 "local_files": ["@DEPLOY@/inbox"],
 "defaults": {"chat_completion": "qwen3.8-27b", "text_to_speech": "fishaudio/drama-3",
              "speech_to_text": "whisper-large-v3-turbo", "text_to_image": "qwen-image-2.1-turbo",
              "text_to_video": "minimax-h3"},
 "voice": {
  "chat_extra": {"chat_template_kwargs": {"enable_thinking": false}, "reasoning_effort": "none"},
  "speech_models": ["fishaudio/drama-3"],
  "draft_after_ms": 100, "early_end_ms": 300, "prime_chat": true, "greedy_transcripts": true,
  "partial_interval_ms": 0, "tool_wait_s": 900, "manage_models": true
 },
 "tools": [
  {"id": "qwen3.8-27b", "kind": "chat", "name": "Qwen3.8 27B (TensorFold 1.1.1, MLX 4-bit + DFlash2 drafter)",
   "engine": "openai_server", "weights": "@CHAT_ROOT@/hf", "qualification": "@CHAT_MARKER@",
   "resident_bytes": 25769803776, "working_bytes": 0, "keep_loaded": true, "priority": 100, "idle_ttl_s": 600,
   "load_timeout_s": 900, "generate_timeout_s": 600,
   "options": {"server": ["@CHAT_ROOT@/tensorfold-1.1.1/bin/tensorfold-native", "serve", "TensorFold/Qwen3.8-27B-MLX-4bit",
                          "--drafter", "z-lab/Qwen3.8-27B-DFlash2", "--host", "127.0.0.1", "--port", "{port}",
                          "--name", "{id}", "--context", "32768", "--prompt-cache-gib", "4", "--parallel", "1",
                          "--no-update-check"],
               "env": {"HF_HUB_CACHE": "@CHAT_ROOT@/hf", "HF_HUB_OFFLINE": "1", "TENSORFOLD_NO_UPDATE_CHECK": "1",
                       "TF_DRAIN_S": "5"},
               "health": "/health"}},
  {"id": "fishaudio/drama-3", "kind": "speech", "name": "Fish Audio Drama 3 (TensorFold native, 44.1 kHz). Built with Fish Audio",
   "cmd": ["/usr/bin/python3", "-I", "@SRC@/tools/speech/drama3/drama3_worker.py"], "weights": "@DRAMA_ROOT@",
   "qualification": "@DRAMA_MARKER@", "resident_bytes": 45097156608, "working_bytes": 0, "keep_loaded": true,
   "priority": 95, "lane": "realtime", "idle_ttl_s": 600, "load_timeout_s": 1200, "generate_timeout_s": 900,
   "options": {"voices": ["Mae", "Arlo", "Ezra", "Nora", "Theo", "Wren"], "default_voice": "Mae",
               "voices_dir": "@DRAMA_ROOT@/voices", "min_speed": 1, "max_speed": 1,
               "max_input_chars": 4096, "stream": true, "references": true, "port": @DRAMA_PORT@, "max_frames": 1024,
               "long_form": false, "verify": "size"}},
  {"id": "whisper-large-v3-turbo", "kind": "transcription", "name": "Whisper large-v3-turbo",
   "cmd": ["@J@/venvs/whisper/bin/python", "@SRC@/tools/speech/whisper/worker.py"], "weights": "@WHISPER@",
   "resident_bytes": 4294967296, "working_bytes": 2147483648, "keep_loaded": true, "priority": 90, "idle_ttl_s": 3600,
   "options": {"device": "cuda", "dtype": "float16", "attn": "sdpa", "threads": 4, "vad": "silero",
               "vad_model": "@J@/models/vad/silero_vad.jit"}},
  {"id": "qwen-image-2.1-turbo", "kind": "image", "name": "Qwen-Image 2.1 Turbo (FP8, 8 steps)",
   "engine": "qwen_image_turbo", "weights": "@J@/lr/weights/qwen-image-2.1", "idle_ttl_s": 60, "priority": 10, "keep_loaded": true,
   "options": {"precision": "fp8s", "max_side": 1664}},
  {"id": "minimax-h3", "kind": "video", "name": "MiniMax H3 (NVFP4, Turbo 8 steps, with audio)",
   "engine": "minimax_h3", "weights": "@J@/lr/weights/minimax-h3", "idle_ttl_s": 30, "priority": 0,
   "options": {"max_width": 768, "max_height": 448, "max_seconds": 5}}
 ]
}
