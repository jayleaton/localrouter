{
 "local_files": ["@DEPLOY@/inbox"],
 "defaults": {"chat_completion": "qwen3.8-27b", "text_to_speech": "fishaudio/drama-3",
              "speech_to_text": "whisper-large-v3-turbo", "text_to_image": "qwen-image-2.1-turbo",
              "image_edit": "qwen-image-2.1-turbo", "typed_decision": "knowline-4b", "image_to_3d": "idol"},
 "stt": {"language": "en"},
 "voice": {
  "chat_extra": {"chat_template_kwargs": {"enable_thinking": false}, "reasoning_effort": "none", "top_p": 0.8},
  "temperature": 0.7,
  "speech_models": ["fishaudio/drama-3"],
  "prime_chat": true, "greedy_transcripts": true,
  "partial_interval_ms": 0, "tool_wait_s": 900, "manage_models": true, "shadow_decisions": true
 },
 "tools": [
  {"id": "qwen3.8-27b", "kind": "chat", "name": "Qwen3.8 27B (TensorFold 1.1.4 Metal, MLX 4-bit + DFlash2 drafter)",
   "engine": "openai_server", "weights": "@HF_HUB@", "priority": 100, "idle_ttl_s": 600,
   "load_timeout_s": 900, "generate_timeout_s": 600,
   "license": {"name": "Apache-2.0", "url": "https://huggingface.co/TensorFold/Qwen3.8-27B-MLX-4bit",
               "use": "the checkpoint (base Qwen/Qwen3.8-27B) and the z-lab DFlash2 drafter", "commercial": true},
   "options": {"server": ["@CHAT_BIN@", "serve", "TensorFold/Qwen3.8-27B-MLX-4bit",
                          "--drafter", "z-lab/Qwen3.8-27B-DFlash2", "--host", "127.0.0.1", "--port", "{port}",
                          "--name", "{id}", "--context", "32768", "--prompt-cache-gib", "4", "--parallel", "1",
                          "--no-update-check"],
               "env": {"HF_HUB_CACHE": "@HF_HUB@", "HF_HUB_OFFLINE": "1", "TENSORFOLD_NO_UPDATE_CHECK": "1",
                       "TF_DRAIN_S": "5"},
               "health": "/health"}},
  {"id": "fishaudio/drama-3", "kind": "speech", "capabilities": ["text_to_speech", "voice_clone"],
   "name": "Fish Audio Drama 3 (TensorFold native on Metal, 44.1 kHz). Built with Fish Audio",
   "cmd": ["@PYTHON@", "-I", "@SRC@/tools/speech/drama3/drama3_worker_macos.py"], "weights": "@DRAMA_ROOT@",
   "qualification": "@DRAMA_MARKER@", "priority": 95, "lane": "realtime", "idle_ttl_s": 600,
   "load_timeout_s": 1200, "generate_timeout_s": 900,
   "license": {"name": "Fish Audio Community License v1.0",
               "url": "https://huggingface.co/plotarmordev/drama-3-NVFP4-Pruned/blob/494db08481db952f834b2241bce63fb3dfa72554/LICENSE",
               "use": "research and non-commercial use; commercial use only under USD 500,000 annual revenue; no Hosted Service (third parties generating speech, e.g. through an API) without a separate licence from Fish Audio",
               "commercial": true, "notice": "Built with Fish Audio"},
   "options": {"variant": "nvfp4", "voices": ["Mae", "Arlo", "Ezra", "Nora", "Theo", "Wren"], "default_voice": "Mae",
               "min_speed": 1, "max_speed": 1, "max_input_chars": 4096, "stream": true, "references": false,
               "instructions": "[{s}] ", "port": @DRAMA_PORT@, "max_frames": 1024, "long_form": false, "verify": "size",
               "clone_working_bytes": 3758096384}},
  {"id": "whisper-large-v3-turbo", "kind": "transcription", "name": "Whisper large-v3-turbo (mlx-whisper, FP16 on Metal)",
   "cmd": ["@J@/venvs/whisper-mlx/bin/python", "@SRC@/tools/speech/whisper/macos/worker.py"], "weights": "@WHISPER@",
   "priority": 90, "lane": "realtime", "idle_ttl_s": 3600,
   "license": {"name": "MIT", "url": "https://huggingface.co/openai/whisper-large-v3-turbo", "commercial": true},
   "options": {"dtype": "float16", "threads": 4, "vad": "silero", "vad_model": "@J@/models/vad/silero_vad.jit"}},
  {"id": "knowline-4b", "kind": "decision", "name": "KnowLine-4B Gen5.5 (typed decisions, System One shape; bf16, MLX on Metal)",
   "engine": "openai_server", "weights": "@J@/models/decide/knowline-4b-gen5.5", "spare_room_only": true,
   "priority": 15, "idle_ttl_s": 600, "load_timeout_s": 120, "generate_timeout_s": 60,
   "license": {"name": "Apache-2.0", "url": "https://huggingface.co/PelaAI/KnowLine-4B-Gen5.5", "commercial": true},
   "options": {"server": ["@J@/venvs/decide-mlx/bin/python", "-I", "@SRC@/tools/decide/knowline/macos/serve_mlx.py",
                          "{weights}", "--port", "{port}", "--served-model-name", "{id}"],
               "env": {"HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1"}, "health": "/health"}},
  {"id": "qwen-image-2.1-turbo", "kind": "image", "name": "Qwen-Image 2.1 Turbo (macOS, MLX-Serve 4-bit, 8 steps)",
   "capabilities": ["text_to_image", "image_edit"],
   "cmd": ["@IMAGE_ROOT@/venv/bin/python", "-I", "@SRC@/tools/image/qwen-mlx/qwen_mlx_worker.py"],
   "weights": "@IMAGE_ROOT@/qwen-image-2.1-turbo-mlx-q4", "priority": 10, "idle_ttl_s": 60,
   "load_timeout_s": 600, "generate_timeout_s": 600,
   "license": {"name": "Qwen Research License Agreement", "url": "https://huggingface.co/Qwen/Qwen-Image-2.1/blob/main/LICENSE",
               "use": "non-commercial: research or evaluation only; commercial use needs a separate licence from Qwen",
               "commercial": false},
   "options": {"pack": "q4", "max_side": 1360, "max_pixels": 1048576, "edit_refs": 5}},
  {"id": "idol", "kind": "asset3d", "name": "Idol (one image to a 3D Gaussian splat, PyTorch MPS, eager)",
   "capabilities": ["image_to_3d"],
   "cmd": ["@J@/venvs/asset3d-idol/bin/python", "-I", "@SRC@/tools/asset3d/idol/worker.py"],
   "weights": "@J@/models/idol", "priority": 0, "idle_ttl_s": 120,
   "load_timeout_s": 300, "generate_timeout_s": 600,
   "license": {"name": "Apache-2.0 (Idol, its BiRefNet copy, the FLUX.2 autoencoder) + DINOv3 License (the image encoder)",
               "url": "https://github.com/facebookresearch/dinov3/blob/6876159a11b4df116f30f667f8c9888617df0751/LICENSE.md",
               "notice": "DINOv3 License (Last Updated August 19, 2025), kept as <weights>/dinov3/LICENSE.md: redistribute only under it with a copy; acknowledge use in publications; no reverse engineering; Trade Controls apply; no ITAR or prohibited end uses (military, nuclear, espionage, ...).",
               "commercial": true},
   "options": {"formats": ["ply"], "input_modes": ["synthetic", "real"],
               "min_gaussians": 32768, "max_gaussians": 1048576, "gaussian_multiple": 32, "default_gaussians": 262144,
               "default_steps": 50, "default_guidance": 3.0, "max_steps": 100, "max_guidance": 10,
               "working_bytes_by_gaussians": {"32768": 8053063680, "262144": 8053063680, "1048576": 8053063680}}}
 ]
}
