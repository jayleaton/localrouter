{
 "machine": "@MACHINE@",
 "reserve_bytes": @RESERVE_BYTES@,
 "budget_bytes": @BUDGET_BYTES@,
 "local_files": ["@DEPLOY@/inbox"],
 "defaults": {"chat_completion": "@CHAT_DEFAULT@", "text_to_speech": "qwen3-tts-customvoice",
              "speech_to_text": "@STT_DEFAULT@"},
 "stt": {"language": "en"},
 "voice": {
  "chat_model": "@VOICE_CHAT@",
  "chat_extra": {"chat_template_kwargs": {"enable_thinking": false}, "top_p": 0.8},
  "temperature": 0.7,
  "speech_models": ["qwen3-tts-customvoice"],
  "voice": "@VOICE@",
  "prime_chat": true, "greedy_transcripts": true, "partial_interval_ms": 0, "manage_models": true
 },
 "tools": [
  {"id": "qwen3.8-flash-next", "kind": "chat",
   "name": "Qwen3.8 Flash-Next (Gufo on ROCm, UD-Q4_K_XL + MTP head, rootless Podman)",
   "engine": "openai_server", "weights": "@FLASHNEXT_DIR@", "resident_bytes": @FLASHNEXT_RESIDENT@, "working_bytes": 0, "keep_loaded": false,
   "priority": 100, "idle_ttl_s": 900, "load_timeout_s": 600, "generate_timeout_s": 600,
   "license": {"name": "Apache-2.0 (model); MIT (Gufo)", "url": "https://github.com/gufo-org/gufo", "commercial": true},
   "options": {"server": ["@SRC@/tools/gufo/serve.sh", "llm", "{port}", "-v", "{weights}:/m:ro", "--",
                          "gufo", "serve", "llm", "--model", "/m/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
                          "--mmproj", "/m/mmproj-BF16.gguf", "--speculative", "mtp",
                          "--mtp-model", "/m/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf",
                          "--served-model-name", "{id}", "--context", "32768", "--sessions", "2",
                          "--cache-ram-bytes", "4294967296"],
               "port": @GUFO_LLM_PORT@, "health": "/v1/models", "stop_timeout_s": 30,
               "memory": "Strix Halo (Radeon 8060S, 96 GiB GTT): GTT peak 88.0 GiB serving at 32k context, 2 sessions, MTP"}},
  {"id": "qwen3.8-flash-next-q3", "kind": "chat",
   "name": "Qwen3.8 Flash-Next (llama.cpp llama-server, Vulkan, UD-Q3_K_XL + MTP head)",
   "engine": "openai_server", "weights": "@Q3_DIR@", "resident_bytes": @Q3_RESIDENT@, "working_bytes": 0, "keep_loaded": false,
   "priority": 90, "idle_ttl_s": 900, "load_timeout_s": 600, "generate_timeout_s": 600,
   "license": {"name": "Apache-2.0 (model); MIT (llama.cpp)", "url": "https://github.com/ggml-org/llama.cpp", "commercial": true},
   "options": {"server": ["@LLAMA_BIN@/llama-server", "-m", "{weights}/UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00001-of-00004.gguf",
                          "-ngl", "999", "-fa", "on", "-c", "32768", "--jinja", "--host", "127.0.0.1", "--port", "{port}",
                          "--alias", "{id}", "--temp", "1.0", "--top-p", "0.95", "--top-k", "20", "--min-p", "0",
                          "-md", "{weights}/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf", "-ngld", "999",
                          "--spec-type", "draft-mtp", "--spec-draft-n-max", "2"],
               "env": {"LD_LIBRARY_PATH": "@LLAMA_BIN@"}, "port": @LLAMA_PORT@, "health": "/health",
               "memory": "Strix Halo: GTT 61.4 GiB serving at 32k context with the MTP head"}},
  {"id": "qwen3-tts-customvoice", "kind": "speech", "capabilities": ["text_to_speech"],
   "name": "Qwen3-TTS 12Hz 1.7B CustomVoice (Gufo on ROCm, 24 kHz, streamed)",
   "cmd": ["@PYTHON@", "-I", "@SRC@/tools/speech/openai_audio/worker.py"], "weights": "@TTS_DIR@",
   "resident_bytes": @TTS_RESIDENT@, "working_bytes": 0, "keep_loaded": true, "priority": 95, "lane": "realtime",
   "idle_ttl_s": 3600, "load_timeout_s": 300, "generate_timeout_s": 600,
   "license": {"name": "Apache-2.0", "url": "https://huggingface.co/Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice", "commercial": true},
   "options": {"server": ["@SRC@/tools/gufo/serve.sh", "tts", "{port}", "-v", "{weights}:/m:ro", "--",
                          "gufo", "serve", "tts", "--model", "/m", "--served-model-name", "{id}"],
               "port": @GUFO_TTS_PORT@, "health": "/v1/audio/voices", "sample_rate": 24000, "stream": true,
               "voices": ["aiden", "dylan", "eric", "ono_anna", "ryan", "serena", "sohee", "uncle_fu", "vivian"],
               "default_voice": "@VOICE@", "min_speed": 1, "max_speed": 1, "max_input_chars": 4096}},
  {"id": "qwen3-asr", "kind": "transcription",
   "name": "Qwen3-ASR 1.7B (Gufo on ROCm)",
   "cmd": ["@PYTHON@", "-I", "@SRC@/tools/speech/openai_audio/worker.py"], "weights": "@ASR_DIR@",
   "resident_bytes": @ASR_RESIDENT@, "working_bytes": 0, "keep_loaded": true, "priority": 92, "lane": "realtime",
   "idle_ttl_s": 3600, "load_timeout_s": 300, "generate_timeout_s": 600,
   "license": {"name": "Apache-2.0", "url": "https://huggingface.co/Qwen/Qwen3-ASR-1.7B", "commercial": true},
   "options": {"server": ["@SRC@/tools/gufo/serve.sh", "asr", "{port}", "-v", "{weights}:/m:ro", "--",
                          "gufo", "serve", "asr", "--model", "/m", "--served-model-name", "{id}"],
               "port": @GUFO_ASR_PORT@, "health": "/v1/models", "max_audio_s": 1800}},
  {"id": "whisper-large-v3-turbo", "kind": "transcription", "name": "Whisper large-v3-turbo (PyTorch ROCm, FP16)",
   "cmd": ["@J@/venvs/whisper-rocm/bin/python", "@SRC@/tools/speech/whisper/worker.py"], "weights": "@WHISPER_DIR@",
   "resident_bytes": 2684354560, "working_bytes": 536870912, "priority": 85, "idle_ttl_s": 600,
   "license": {"name": "MIT", "url": "https://huggingface.co/openai/whisper-large-v3-turbo", "commercial": true},
   "options": {"device": "cuda", "dtype": "float16", "attn": "sdpa", "threads": 4, "vad": "off"}},
  {"id": "minimax-h3", "kind": "video", "capabilities": ["text_to_video", "image_to_video"],
   "name": "MiniMax H3 text/image to video with audio (ComfyUI, int8 fl2va DiT + 4-step turbo LoRA, PyTorch ROCm)",
   "cmd": ["@PYTHON@", "-I", "@SRC@/tools/comfyui/worker.py"], "resident_bytes": @H3_RESIDENT@, "working_bytes": 0,
   "priority": 10, "idle_ttl_s": 120, "load_timeout_s": 600, "generate_timeout_s": 3600,
   "license": {"name": "MiniMax H3 Community License Agreement", "url": "https://huggingface.co/MiniMaxAI/MiniMax-H3/blob/main/LICENSE",
               "use": "only outside the excluded territories, under its Acceptable Use Policy; over USD 20 million yearly revenue needs MiniMax's written authorization",
               "commercial": true, "excluded_regions": ["United States", "European Union", "United Kingdom", "South Korea"],
               "notice": "content published to the public must be disclosed as machine-generated; a commercial product shows \"MiniMax H3\" in its user interface"},
   "options": {"comfy_dir": "@COMFY_DIR@", "python": "@COMFY_PYTHON@", "port": @COMFY_H3_PORT@,
               "args": ["--bf16-vae", "--disable-mmap", "--cache-none"],
               "env": {"HSA_USE_SVM": "0", "PYTORCH_HIP_ALLOC_CONF": "expandable_segments:True", "MIOPEN_FIND_MODE": "FAST"},
               "workflow": "@SRC@/deploy/strix-halo/comfyui/minimax-h3-t2va.json",
               "bindings": {"prompt": "6.prompt", "width": "6.width", "height": "6.height", "frames": "6.length",
                            "seed": "7.noise_seed", "steps": "9.steps", "fps": "14.fps", "audio": "14.audio"},
               "size_multiple": 32, "min_side": 256, "max_side": 1344, "frame_multiple": 17, "frame_offset": 5, "fps": [24],
               "modes": {"image_to_video": {"bindings": {"first_frame": "6.first_frame"}}},
               "default_width": 512, "default_height": 288, "stop_timeout_s": 30,
               "memory": "Strix Halo: booked as the whole GTT budget (ComfyUI stages weights in host RAM, which the GTT budget does not see); see deploy/strix-halo/README.md"}},
  {"id": "minimax-h3-image", "kind": "image", "capabilities": ["text_to_image", "image_edit"],
   "name": "MiniMax H3-Image (ComfyUI, Unsloth Q4_K_M GGUF, or Q8_0 for whole-scene edits, via ComfyUI-GGUF, PyTorch ROCm)",
   "cmd": ["@PYTHON@", "-I", "@SRC@/tools/comfyui/worker.py"], "resident_bytes": @H3IMG_RESIDENT@, "working_bytes": 0,
   "priority": 10, "idle_ttl_s": 120, "load_timeout_s": 600, "generate_timeout_s": 1800,
   "license": {"name": "MiniMax H3-Image Community License Agreement", "url": "https://huggingface.co/MiniMaxAI/MiniMax-H3-Image/blob/main/LICENSE",
               "use": "only outside the excluded territories, under its Acceptable Use Policy (see its Additional Commercial Terms)",
               "commercial": true, "excluded_regions": ["United States", "European Union", "United Kingdom", "South Korea"]},
   "options": {"comfy_dir": "@COMFY_DIR@", "python": "@COMFY_PYTHON@", "port": @COMFY_H3IMG_PORT@,
               "args": ["--bf16-vae", "--disable-mmap", "--cache-none"],
               "env": {"HSA_USE_SVM": "0", "PYTORCH_HIP_ALLOC_CONF": "expandable_segments:True", "MIOPEN_FIND_MODE": "FAST"},
               "workflow": "@SRC@/deploy/strix-halo/comfyui/minimax-h3-image-t2i.json",
               "bindings": {"prompt": "4.prompt", "width": "4.width", "height": "4.height", "seed": "6.seed", "steps": "6.steps", "guidance": "6.cfg"},
               "modes": {"image_edit": {"workflow": "@SRC@/deploy/strix-halo/comfyui/minimax-h3-image-edit.json",
                                        "bindings": {"references": ["11.image", "4.images.image_2", "4.images.image_3", "4.images.image_4", "4.images.image_5"],
                                                     "mask": "14.mask", "width": ["4.width", "15.width"], "height": ["4.height", "15.height"]},
                                        "defaults": {"steps": 6, "guidance": 1.0},
                                        "unmasked": {"workflow": "@SRC@/deploy/strix-halo/comfyui/minimax-h3-image-edit-unmasked.json",
                                                     "bindings": {"mask": null, "width": "4.width", "height": "4.height"},
                                                     "defaults": {"steps": 30, "guidance": 1.0}}}},
               "size_multiple": 32, "min_side": 256, "max_side": 2048, "stop_timeout_s": 30,
               "memory": "Strix Halo: booked as the whole GTT budget, as minimax-h3"}}
 ]
}
