{
  "name": "localrouter-companion",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "LocalRouter's reference harness for the user's own computer: the local computer executor (its policy and approvals), the harness runtime, and the desktop app",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "localrouter-executor-mcp": "src/executor/mcpMain.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run type-check && npm run lint && npm test",
    "build": "node scripts/build.mjs",
    "package:mac": "node scripts/build.mjs && bash scripts/package-mac.sh",
    "package:linux": "node scripts/build.mjs && electron-builder --linux --config electron-builder.yml --publish never",
    "package:win": "node scripts/build.mjs && electron-builder --win --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
