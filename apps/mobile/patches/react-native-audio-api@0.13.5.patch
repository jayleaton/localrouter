+// Voice-I/O setup posts configuration/route notifications too. Once the engine
+// is running with those same formats and devices, rebuilding would enable voice
+// I/O again and post another notification forever. Compare on the engine lock,
+// after delivery to the main queue, and ignore notifications from retired engines.
+- (NSString *)configurationSignature
+{
+  AVAudioSession *session = [AVAudioSession sharedInstance];
+  NSMutableArray<NSString *> *parts = [NSMutableArray array];
+  AVAudioFormat *output = [self.audioEngine.outputNode inputFormatForBus:0];
+  [parts addObject:[NSString stringWithFormat:@"out:%f:%u", output.sampleRate, output.channelCount]];
+  if (self.inputRegistration != nil) {
+    AVAudioFormat *input = [self.audioEngine.inputNode outputFormatForBus:0];
+    [parts addObject:[NSString stringWithFormat:@"in:%f:%u", input.sampleRate, input.channelCount]];
+  }
+  for (AVAudioSessionPortDescription *port in session.currentRoute.inputs) {
+    [parts addObject:[@"input:" stringByAppendingString:port.UID]];
+  }
+  for (AVAudioSessionPortDescription *port in session.currentRoute.outputs) {
+    [parts addObject:[@"output:" stringByAppendingString:port.UID]];
+  }
+  return [parts componentsJoinedByString:@"|"];
+}
+
+- (void)handleConfigurationChangeFromEngineAddress:(uintptr_t)notifyingEngineAddress
+{
+  std::scoped_lock lock(_engineLock);
+  if (notifyingEngineAddress != 0 &&
+      notifyingEngineAddress != (uintptr_t)(__bridge void *)self.audioEngine) {
+    return;
+  }
+  if (![self hasTrackedGraph]) {
+    return;
+  }
+  if (!self.graphNeedsRebuild && !self.sessionDeactivationInvalidatedGraph &&
+      [_runningConfiguration isEqualToString:[self configurationSignature]]) {
+    // AVAudioEngine stops itself on configuration notifications. If the format
+    // is unchanged, resume this graph instead of recreating voice I/O (which
+    // posts another notification and can repeatedly invalidate the input).
+    if (![self.audioEngine isRunning]) {
+      [self startEngine];
+      [self notifyConfigurationChanges];
+    }
+    return;
+  }
+  [self.sessionManager markInactive];
+  [self rebuildAudioEngineAndResumeIfNeeded];
+}
+
