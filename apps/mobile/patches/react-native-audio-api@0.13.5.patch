+// Backport of upstream 6f579e9: voiceChat must opt into AVAudioEngine voice I/O.
+// Apply before reading formats or connecting nodes; voice processing changes the
+// hardware format. This app uses voiceChat only for full-duplex conversation.
+- (void)applyVoiceProcessing
+{
+  BOOL wantsVoiceProcessing =
+      self.inputRegistration != nil &&
+      [self.sessionManager.desiredMode isEqualToString:AVAudioSessionModeVoiceChat];
+  if ((!wantsVoiceProcessing && !_voiceProcessingApplied) || self.audioEngine == nil) {
+    return;
+  }
+  AVAudioInputNode *systemInputNode = self.audioEngine.inputNode;
+  if (systemInputNode.isVoiceProcessingEnabled == wantsVoiceProcessing) {
+    _voiceProcessingApplied = wantsVoiceProcessing;
+    [self applyVoiceProcessingDucking:systemInputNode];
+    return;
+  }
+  if ([self.audioEngine isRunning]) {
+    [self.audioEngine stop];
+  }
+  NSError *error = nil;
+  if (![systemInputNode setVoiceProcessingEnabled:wantsVoiceProcessing error:&error]) {
+    NSLog(@"[AudioEngine] Could not configure voice processing: %@", error);
+    return;
+  }
+  _voiceProcessingApplied = wantsVoiceProcessing;
+  [self applyVoiceProcessingDucking:systemInputNode];
+}
+
+// Voice processing ducks other apps' audio by default, for as long as it runs. Sidebud keeps it on
+// only while a call streams, and asks for the least ducking, only while someone is speaking.
+- (void)applyVoiceProcessingDucking:(AVAudioInputNode *)inputNode
+{
+  if (!inputNode.isVoiceProcessingEnabled) {
+    return;
+  }
+  if (@available(iOS 17.0, *)) {
+    AVAudioVoiceProcessingOtherAudioDuckingConfiguration ducking;
+    ducking.enableAdvancedDucking = YES;
+    ducking.duckingLevel = AVAudioVoiceProcessingOtherAudioDuckingLevelMin;
+    inputNode.voiceProcessingOtherAudioDuckingConfiguration = ducking;
+  }
+}
