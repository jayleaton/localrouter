{
  "name": "localrouter-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "type-check": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "tsx e2e/headless.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.5",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "19.2.18",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"],
    "packageExtensions": {
      "react-native-drawer-layout": {
        "peerDependenciesMeta": {
          "react-native-reanimated": { "optional": true }
        }
      }
    },
    "patchedDependencies": {
      "react-native-audio-api@0.13.5": "patches/react-native-audio-api@0.13.5.patch"
    }
  }
}
